# VP Earner .env.example — reference for required credentials
# Credentials are centralized in the Hermes profile .env (default profile).
# Copy this file to .env only for local development outside Hermes.
#
# Virtuals Protocol / Privy
WALLET_ADDRESS=0x...           # Your EVM wallet address on Base
PRIVY_WALLET_ID=...           # Privy wallet ID from Virtuals console
PRIVY_SIGNER_PRIVATE_KEY=...  # Signer private key (requires OAuth approval)
CHAIN_ID=8453                 # Base mainnet
BUILDER_CODE=...              # ACP builder code from Virtuals console (prefix: bc-)
ALCHEMY_API_KEY=...           # Alchemy API key for Base RPC
VIRTUALS_API_KEY=...          # Virtuals Protocol API key
ANTHROPIC_API_KEY=...         # Anthropic API key (for Claude-based tasks)
